# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Optional Paystack secret key (sk_test_... or sk_live_...) for live Paystack API calls and HMAC SHA-512 webhook verification.
# Falls back to interactive Paystack Test Mode simulator when not configured.
PAYSTACK_SECRET_KEY=""

# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY: Optional Paystack public key (pk_test_... or pk_live_...).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# WHATSAPP_WEBHOOK_URL: Optional Meta/Twilio WhatsApp Business API webhook endpoint for automated guest receipts.
WHATSAPP_WEBHOOK_URL=""

# RESEND_API_KEY: Optional Resend API key for transactional booking confirmation emails.
RESEND_API_KEY=""

# GOOGLE_MAPS_API_KEY: Provisioned by AI Studio for Google Maps Platform JavaScript API.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

